    {
      "parameters": {
        "jsCode": "const SENIORITY = [\n  { re: /\\b(cto|ciso|cio|chief|vp |vice president|head of|director)\\b/, pts: 25 },\n  { re: /\\b(manager|lead|principal|architect)\\b/,                      pts: 18 },\n  { re: /\\b(senior|engineer|developer|devops|sre|admin)\\b/,             pts: 12 },\n  { re: /\\b(analyst|associate|intern|student|assistant)\\b/,             pts: 4 }\n];\n\nconst FIT    = { strong: 15, partial: 9, weak: 4, none: 0 };\nconst SIZE   = { '1-50': 0, '51-200': 6, '201-1000': 11, '1000+': 15 };\nconst DEPLOY = {\n  'Not yet using': 0,\n  'Evaluating': 5,\n  'Self-hosted community': 20,\n  'Cloud (Starter or Pro)': 12,\n  'Business or Enterprise': 8\n};\nconst WF = { 'None': 0, '1-10': 4, '11-50': 9, '50+': 15 };\n\nreturn $input.all().map((item, i) => {\n  const src = $('Extract page signals').all()[i].json;\n\n  let ai = {};\n  try {\n    ai = JSON.parse((item.json.text || '').replace(/```json|```/g, '').trim());\n  } catch (e) {\n    ai = { icp_fit: 'none', industry: 'unknown', regulated_sector: 'unclear', reasoning: 'AI output not parsable' };\n  }\n\n  const firmographic =\n    (SIZE[src.size_band] || 0) +\n    (FIT[ai.icp_fit] || 0);\n\n  const governance =\n    (DEPLOY[src.deployment] || 0) +\n    (WF[src.wf_band] || 0) +\n    (ai.regulated_sector === 'yes' ? 10 : 0);\n\n  const title = src.job_title || '';\n  const seniority = (SENIORITY.find(r => r.re.test(title)) || { pts: 6 }).pts;\n\n  const score = firmographic + governance + seniority;\n  const fit_tier = score >= 70 ? 'High fit' : score >= 40 ? 'Emerging fit' : 'Out of ICP';\n\n  return {\n    json: {\n      ...src,\n      industry: ai.industry,\n      icp_fit: ai.icp_fit,\n      regulated_sector: ai.regulated_sector,\n      ai_reasoning: ai.reasoning,\n      score_firmographic: firmographic,\n      score_governance: governance,\n      score_seniority: seniority,\n      score,\n      fit_tier\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1152,
        0
      ],
      "id": "664cf786-b4b8-4d10-aac3-662d2869ec89",
      "name": "Score"
